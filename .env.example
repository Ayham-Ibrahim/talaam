# API base URL for the Laravel backend
VITE_API_BASE_URL=taalam-back-staging.t3allem.com

# THE SWITCH: set to false to use the real backend instead of mock data
VITE_USE_MOCKS=true

# النطاق النهائي للموقع — يُستخدَم لبناء canonical URLs وstructured data
# وsitemap.xml (راجع SEO_IMPLEMENTATION.md). مُؤكَّد.
VITE_SITE_URL=https://t3allem.com

# Meta Pixel — فارغ = التتبع معطّل بالكامل (لا تحميل للبكسل ولا أي حدث)
VITE_META_PIXEL_ID=

# Google Tag Manager (GA4 + Google Ads) — فارغ = معطّل بالكامل. الإنتاج: GTM-W8P9DD9N
VITE_GTM_ID=

# المحادثة اللحظية (Laravel Reverb) — نفس REVERB_APP_KEY في .env الباك. فارغ = WebSocket معطّل
# (المحادثة تعمل بالاستطلاع الدوري). الإنتاج: HOST=دومين الباك، PORT=443، SCHEME=https
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
